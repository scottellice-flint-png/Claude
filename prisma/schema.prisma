  user            User      @relation(fields: [userId], references: [id])
  approvedBy      AdminUser? @relation(fields: [approvedById], references: [id])

  @@unique([userId])
  @@index([status])
  @@map("dmm_registrations")
}

// ============================================================================
// MARKET MAKER BOT - Internal Seed Bot Configuration
// Chinese Wall compliant - only accesses public data
// ============================================================================

model MarketMakerBot {
  id              String    @id @default(uuid())

  name            String
  botType         String    @default("passive_quoter") // passive_quoter, spread_bot, seed_bot

  // Configuration
  isActive        Boolean   @default(false)

  // Strategy parameters (JSON)
  config          String    // JSON: { spreadCents, minQuantityCents, maxInventoryCents, etc. }

  // Chinese Wall Compliance
  // Bot can ONLY access these endpoints:
  // - GET /api/markets (public)
  // - GET /api/orderbook (public)
  // - POST /api/orders (standard user endpoint)
  accessLevel     String    @default("public_only") // public_only (enforced)

  // Inventory tracking (for risk management)
  currentInventoryYesCents BigInt @default(0)
  currentInventoryNoCents  BigInt @default(0)
  maxInventoryCents BigInt  @default(1000000) // $10,000 default max

  // Performance
  totalVolumeProvidedCents BigInt @default(0)
  totalTradesExecuted Int   @default(0)
  totalPnlCents    BigInt   @default(0)

  // Risk state
  isHalted         Boolean  @default(false)
  haltReason       String?
  lastActivityAt   DateTime?

  // Sharp Shield V2 - Hardening Features
  orderTtlMs       Int       @default(3000) // Order TTL in milliseconds (3 seconds default)
  maxOrdersPerCycle Int      @default(10)   // Max orders per quoting cycle

  // Kill Switch
  killSwitchActive Boolean   @default(false)
  killSwitchTriggeredAt DateTime?
  killSwitchReason String?
  killSwitchCooldownUntil DateTime?

  // Rolling Loss Tracking
  rollingLossCents BigInt    @default(0)
  rollingLossWindowStartAt DateTime?
  rollingLossThresholdCents BigInt @default(100000) // $1,000 default

  // Exposure Caps
  globalExposureCents BigInt @default(0)
  globalExposureCapCents BigInt @default(5000000) // $50,000 default
  perMarketExposureCapCents BigInt @default(500000) // $5,000 default

  // Quote Quality Tracking
  lastQuoteAt      DateTime?
  quoteSpreadCents Int?
  quoteMidPriceCents Int?
  quoteErrorCount  Int       @default(0)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Associated user account for the bot
  userId          String?
  user            User?     @relation(fields: [userId], references: [id])

  @@index([isActive])
  @@index([killSwitchActive])
  @@map("market_maker_bots")
}

// ============================================================================
// RISK EVENTS - Anti-Sharp & Toxic Flow Detection
// ============================================================================

model RiskEvent {
  id              String    @id @default(uuid())

  // Event classification
  eventType       String    // TOXIC_FLOW, IP_CLUSTER, RAPID_FIRE, INVENTORY_SKEW, LATENCY_ARB
  severity        String    @default("low") // low, medium, high, critical

  // Target
  userId          String?
  marketId        String?
  ipAddress       String?

  // Detection details
  detectionRule   String    // Rule that triggered this event
  triggerData     String    // JSON: data that triggered detection

  // Impact metrics
  tradesAffected  Int       @default(0)
  volumeAffectedCents BigInt @default(0)

  // Response action
  actionTaken     String?   // SPREAD_WIDEN, HALT_USER, HALT_MARKET, ALERT_ONLY
  actionDetails   String?   // JSON: details of action taken

  // Status
  status          String    @default("active") // active, resolved, false_positive
  resolvedAt      DateTime?
  resolvedById    String?
  resolutionNotes String?

  createdAt       DateTime  @default(now())

  // Relations
  user            User?     @relation(fields: [userId], references: [id])
  market          Market?   @relation(fields: [marketId], references: [id])
  resolvedBy      AdminUser? @relation(fields: [resolvedById], references: [id])

  @@index([eventType, createdAt])
  @@index([userId])
  @@index([marketId])
  @@index([severity, status])
  @@map("risk_events")
}

// ============================================================================
// MARKET LIQUIDITY STATE - Real-time Liquidity Tracking
// Used for NT bet caps and dynamic spread adjustments
// ============================================================================

model MarketLiquidityState {
  id              String    @id @default(uuid())

  marketId        String    @unique

  // Current liquidity metrics - ALL IN CENTS
  totalLiquidityCents BigInt @default(0) // Total liquidity available
  bidLiquidityCents   BigInt @default(0) // Buy-side liquidity
  askLiquidityCents   BigInt @default(0) // Sell-side liquidity

  // Best bid/ask
  bestBidCents    Int?      // Best bid price in cents
  bestAskCents    Int?      // Best ask price in cents
  midPriceCents   Int?      // Mid price in cents
  spreadCents     Int?      // Current spread in cents

  // NT Liquidity-Locked Bet Cap
  // If totalLiquidityCents < 1000000 (=$10,000), maxBetCents = 50000 (=$500)
  liquidityTier   String    @default("seed") // seed (<$10k), growth, mature
  maxBetCents     Int       @default(50000) // Current max bet allowed

  // Dynamic spread state (Anti-Sharp)
  spreadMultiplier Float    @default(1.0) // 1.0 = normal, 3.0 = 300% widened
  spreadReason    String?   // NORMAL, TOXIC_FLOW_HALT, HIGH_VOLATILITY

  // Trade velocity tracking (for toxic flow detection)
  tradesLast2Sec  Int       @default(0)
  lastTradeAt     DateTime?

  // Sharp Shield V2 - Effective Depth & Tier Calculation
  effectiveDepthCents BigInt @default(0) // min(bidLiquidity, askLiquidity) within 10% of mid
  sharpShieldTier Int       @default(0)  // 0: Seed (<$1k), 1: Growth ($1k-$10k), 2: Active ($10k-$100k), 3: Deep (>$100k)

  // Tier Hysteresis - 5 minute stability requirement
  tierChangePendingSince DateTime?
  tierChangePendingTo Int?
  tierStableSince DateTime?

  // Fee schedule reference
  currentTakerFeeBps Int    @default(100)
  currentMakerRebateBps Int @default(25)

  updatedAt       DateTime  @updatedAt

  // Relations
  market          Market    @relation(fields: [marketId], references: [id])

  @@index([liquidityTier])
  @@index([sharpShieldTier])
  @@map("market_liquidity_states")
}

// ============================================================================
// ORDER BOOK SNAPSHOTS - Historical Order Book Data
// ============================================================================

model OrderBookSnapshot {
  id              String    @id @default(uuid())

  marketId        String
  outcomeId       String

  // Snapshot data
  snapshotAt      DateTime  @default(now())

  // Aggregated levels (JSON arrays)
  bids            String    // JSON: [{ priceCents, quantityCents, orderCount }]
  asks            String    // JSON: [{ priceCents, quantityCents, orderCount }]

  // Summary stats
  bestBidCents    Int?
  bestAskCents    Int?
  totalBidsCents  BigInt    @default(0)
  totalAsksCents  BigInt    @default(0)

  // Trigger reason
  snapshotReason  String    @default("scheduled") // scheduled, trade, significant_change

  @@index([marketId, snapshotAt])
  @@index([outcomeId, snapshotAt])
  @@map("order_book_snapshots")
}

// ============================================================================
// SETTLEMENT RECORDS - NT 2024 Settlement & Refund Tracking
// ============================================================================

model SettlementRecord {
  id              String    @id @default(uuid())

  marketId        String

  // Settlement type
  settlementType  String    // NORMAL, VOID, REFUND

  // Resolution data
  winningOutcomeId String?
  resolutionSource String?  // Source of official result
  resolutionEvidence String? // JSON: evidence/proof data

  // Financial totals - ALL IN CENTS
  totalPayoutCents BigInt   @default(0)
  totalRefundCents BigInt   @default(0)
  platformFeeCents BigInt   @default(0)

  // Status
  status          String    @default("pending") // pending, processing, completed, failed

  // Timing
  initiatedAt     DateTime  @default(now())
  completedAt     DateTime?

  // NT Audit
  reasonCode      String    // MARKET_RESOLVED, MARKET_CANCELLED, ORACLE_RESULT, etc.
  processedById   String?

  // Error handling
  errorMessage    String?
  retryCount      Int       @default(0)

  // Relations
  market          Market    @relation(fields: [marketId], references: [id])
  processedBy     AdminUser? @relation(fields: [processedById], references: [id])
  payouts         SettlementPayout[]

  @@index([marketId])
  @@index([status])
  @@map("settlement_records")
}

// ============================================================================
// SETTLEMENT PAYOUTS - Individual User Payouts
// ============================================================================

model SettlementPayout {
  id              String    @id @default(uuid())

  settlementId    String
  userId          String
  positionId      String

  // Payout details - IN CENTS
  payoutType      String    // WIN, REFUND
  amountCents     Int

  // Position at settlement
  positionQuantityCents Int
  positionAvgPriceCents Int

  // Status
  status          String    @default("pending") // pending, processed, failed
  processedAt     DateTime?

  // Relations
  settlement      SettlementRecord @relation(fields: [settlementId], references: [id])
  user            User      @relation(fields: [userId], references: [id])
  position        Position  @relation(fields: [positionId], references: [id])

  @@index([settlementId])
  @@index([userId])
  @@map("settlement_payouts")
}

// ============================================================================
// PRICE HISTORY - OHLCV Data for Charts
// ============================================================================

model PriceHistory {
  id              String    @id @default(uuid())

  marketId        String
  outcomeId       String

  // Time bucket
  bucketStart     DateTime
  bucketEnd       DateTime
  intervalMinutes Int       // 1, 5, 15, 60, 1440 (day)

  // OHLCV in cents
  openCents       Int
  highCents       Int
  lowCents        Int
  closeCents      Int
  volumeCents     BigInt    @default(0)
  tradeCount      Int       @default(0)

  @@unique([marketId, outcomeId, bucketStart, intervalMinutes])
  @@index([marketId, bucketStart])
  @@map("price_history")
}

// ============================================================================
// SHARP SHIELD V2 - Oracle Lock Service (Push-Based IGA Compliance)
// ============================================================================

model OracleLockState {
  id              String    @id @default(uuid())

  marketId        String    @unique

  // Lock state
  isLocked        Boolean   @default(false)
  lockReason      String?   // MATCH_STARTED, OFFICIAL_RESULT, VOLATILITY, ADMIN_HALT, FEED_FAILURE, DEADMAN_SWITCH

  // External event reference
  externalEventId String?   // e.g., AFL match ID
  externalEventType String? // afl, nrl, cricket, tennis, etc.

  // Lock timing
  lockedAt        DateTime?
  lockedBy        String?   // "oracle", "admin", "deadman"
  unlockedAt      DateTime?

  // Deadman switch - feed health monitoring
  lastHeartbeatAt DateTime?
  heartbeatIntervalMs Int   @default(5000) // Expected heartbeat every 5s
  deadmanTimeoutMs Int      @default(30000) // 30s timeout for feed failure

  // Admin override
  adminOverrideActive Boolean @default(false)
  adminOverrideBy   String?
  adminOverrideAt   DateTime?
  adminOverrideReason String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  market          Market    @relation(fields: [marketId], references: [id])

  @@index([isLocked])
  @@index([externalEventId])
  @@map("oracle_lock_states")
}

model OracleEvent {
  id              String    @id @default(uuid())

  marketId        String

  // Event details
  eventType       String    // HEARTBEAT, MATCH_STARTED, OFFICIAL_RESULT, VOLATILITY, ADMIN_HALT, FEED_FAILURE
  eventSource     String    // afl_oracle, nrl_oracle, admin, system

  // External reference
  externalEventId String?
  externalEventType String?

  // Event data
  eventData       String?   // JSON: event-specific data (match score, result, etc.)

  // Action taken
  lockActionTaken String?   // LOCK, UNLOCK, NONE
  lockReason      String?

  // Processing
  processedAt     DateTime  @default(now())
  processingLatencyMs Int?

  // Audit
  integrityHash   String?   // For audit chain

  // Relations
  market          Market    @relation(fields: [marketId], references: [id])

  @@index([marketId, processedAt])
  @@index([eventType])
  @@index([externalEventId])
  @@map("oracle_events")
}

// ============================================================================
// SHARP SHIELD V2 - Fee Accounting (Double-Entry Ledger)
// ============================================================================

model FeeSchedule {
  id              String    @id @default(uuid())

  // Tier identification
  liquidityTier   Int       // 0, 1, 2, 3 (Sharp Shield tiers)
  effectiveFrom   DateTime  @default(now())
  effectiveUntil  DateTime?

  // Fee rates in basis points (100bp = 1%)
  takerFeeBps     Int       @default(100) // 100bp = 1% taker fee
  makerRebateBps  Int       @default(25)  // 25bp = 0.25% maker rebate
  venueFeeNetBps  Int       @default(75)  // 75bp = 0.75% venue keeps

  // Tier thresholds in cents
  minEffectiveDepthCents BigInt @default(0)
  maxEffectiveDepthCents BigInt?

  // Max order size for tier in cents
  maxOrderSizeCents BigInt?

  // Status
  isActive        Boolean   @default(true)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([liquidityTier, isActive])
  @@map("fee_schedules")
}

model FeeLedger {
  id              String    @id @default(uuid())

  // Transaction reference
  tradeId         String
  batchId         String?

  // Entry type
  entryType       String    // TAKER_FEE, MAKER_REBATE, VENUE_FEE
  entryDirection  String    // DEBIT, CREDIT

  // Account (user or venue)
  accountType     String    // user, venue
  accountId       String?   // userId or null for venue

  // Amount in cents
  amountCents     Int

  // Market context
  marketId        String
  liquidityTier   Int       @default(0)

  // Balance snapshot (running total)
  runningBalanceCents BigInt @default(0)

  // Audit
  reasonCode      String    // TRADE_EXECUTION, REBATE_PAYOUT, ADJUSTMENT
  metadata        String?   // JSON: additional context

  createdAt       DateTime  @default(now())

  @@index([tradeId])
  @@index([accountType, accountId])
  @@index([marketId, createdAt])
  @@index([batchId])
  @@map("fee_ledger")
}

model VenueFeeTotals {
  id              String    @id @default(uuid())

  // Period
  periodDate      DateTime  @db.Date

  // Totals in cents
  totalTakerFeesCents BigInt @default(0)
  totalMakerRebatesCents BigInt @default(0)
  totalVenueNetCents BigInt @default(0)

  // Trade counts
  totalTrades     Int       @default(0)
  totalVolumeCents BigInt   @default(0)

  // By tier breakdown (JSON)
  tierBreakdown   String?   // JSON: { tier0: {...}, tier1: {...}, ... }

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([periodDate])
  @@map("venue_fee_totals")
}

// ============================================================================
// SHARP SHIELD V2 - Deterministic Micro-Batch Processing
// ============================================================================

model PendingOrder {
  id              String    @id @default(uuid())

  // Original order reference
  orderId         String    @unique

  // Market
  marketId        String
  outcomeId       String

  // Order details snapshot
  userId          String
  side            String    // BID (buy YES) or ASK (sell YES)
  priceCents      Int
  quantityCents   Int

  // Batch assignment
  batchId         String?
  batchSequenceNumber BigInt?

  // Queue timing
  queuedAt        DateTime  @default(now())
  batchWindowMs   Int       @default(200) // 200ms batch window

  // Processing state
  status          String    @default("pending") // pending, assigned, processing, completed, cancelled
  processedAt     DateTime?

  // Match result
  matchResult     String?   // JSON: match result
  errorMessage    String?

  // Relations
  market          Market    @relation(fields: [marketId], references: [id])

  @@index([marketId, status, queuedAt])
  @@index([batchId])
  @@index([status, queuedAt])
  @@map("pending_orders")
}

model BatchExecution {
  id              String    @id @default(uuid())

  marketId        String
  batchSequenceNumber BigInt

  // Timing
  batchStartAt    DateTime
  batchEndAt      DateTime
  processingStartAt DateTime?
  processingEndAt DateTime?

  // Batch contents
  ordersInBatch   Int       @default(0)

  // Results
  ordersMatched   Int       @default(0)
  tradesCreated   Int       @default(0)
  volumeTradedCents BigInt  @default(0)

  // Audit
  status          String    @default("pending") // pending, processing, completed, failed
  errorMessage    String?
  integrityHash   String?   // Hash of batch contents for replay

  // State snapshot for replay
  prebatchStateHash String?  // Hash of order book state before batch
  postbatchStateHash String? // Hash of order book state after batch

  createdAt       DateTime  @default(now())

  // Relations
  market          Market    @relation(fields: [marketId], references: [id])

  @@unique([marketId, batchSequenceNumber])
  @@index([marketId, batchStartAt])
  @@index([status])
  @@map("batch_executions")
}

// ============================================================================
// SHARP SHIELD V2 - Rebate Abuse Detection
// ============================================================================

model RebateAbuseFlag {
  id              String    @id @default(uuid())

  userId          String
  marketId        String?

  // Detection
  detectionType   String    // SELF_TRADE, WASH_TRADE, CIRCULAR_FLOW, EXCESSIVE_CANCEL_RATIO

  // Evidence
  tradeIds        String?   // JSON: array of trade IDs involved
  orderIds        String?   // JSON: array of order IDs involved

  // Metrics
  suspiciousVolumeCents BigInt @default(0)
  rebatesClaimedCents Int   @default(0)
  cancelRatio     Float?    // For cancel/fill ratio abuse

  // Time window
  windowStartAt   DateTime
  windowEndAt     DateTime

  // Severity
  severity        String    @default("warning") // warning, moderate, severe

  // Action
  actionTaken     String?   // REBATE_CLAWBACK, ACCOUNT_FLAG, ACCOUNT_SUSPEND
  actionAmountCents Int?
  actionAt        DateTime?
  actionBy        String?

  // Status
  status          String    @default("active") // active, reviewed, resolved, false_positive
  reviewedAt      DateTime?
  reviewedBy      String?
  reviewNotes     String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, status])
  @@index([marketId, createdAt])
  @@index([detectionType, status])
  @@map("rebate_abuse_flags")
}
