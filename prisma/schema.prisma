// Prisma schema for MarketOps Admin System
// Supports full market lifecycle, multi-outcome markets, constraints, audit logging, etc.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// PUBLIC USERS & AUTHENTICATION
// ============================================================================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  username      String    @unique
  passwordHash  String
  firstName     String?
  lastName      String?
  displayName   String?
  avatarUrl     String?
  isActive      Boolean   @default(true)
  isVerified    Boolean   @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Trading stats
  balance       Float     @default(0)
  totalProfit   Float     @default(0)
  totalTrades   Int       @default(0)
  totalVolume   Float     @default(0)

  // Relations - Chats
  createdChats      GroupChat[]         @relation("ChatCreator")
  chatMemberships   GroupChatMember[]
  chatMessages      ChatMessage[]
  sharedPredictions SharedPrediction[]

  // Relations - Social
  followers         UserFollow[]        @relation("UserFollowing")
  following         UserFollow[]        @relation("UserFollowers")

  @@map("users")
}

// ============================================================================
// ADMIN USERS & AUTHENTICATION
// ============================================================================

model AdminUser {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          String    @default("operator") // super_admin, admin, operator, viewer
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  marketVersions    MarketVersion[]
  approvals         MarketApproval[]
  auditLogs         AuditLog[]
  createdMarkets    Market[]          @relation("MarketCreator")
  assignedMarkets   Market[]          @relation("MarketAssignee")
  resolutions       MarketResolution[]

  @@map("admin_users")
}

// ============================================================================
// MARKETS - Core entity
// ============================================================================

model Market {
  id                String   @id @default(uuid())
  slug              String   @unique

  // Basic Info
  title             String
  shortDescription  String   // For market cards
  description       String   // Full description (supports markdown)

  // Status & Workflow
  status            String   @default("draft") // draft, review, approved, published, trading_halted, resolved, settled, archived

  // Category & Organization
  categoryId        String
  subcategoryId     String?
  isFeatured        Boolean  @default(false)
  featuredOrder     Int?

  // Display Info (Market Card)
  icon              String?  // Emoji or icon name
  heroImageUrl      String?
  cardImageUrl      String?

  // Market Type
  marketType        String   @default("binary") // binary, multi_outcome

  // Dates & Timezone
  timezone          String   @default("Australia/Sydney")
  opensAt           DateTime?
  closesAt          DateTime
  resolvesBy        DateTime
  settlesBy         DateTime

  // Trading Constraints (stored as JSON)
  constraints       String   @default("{}") // JSON: min/max trade, position limits, etc.

  // Rules
  rulesText         String   // Human readable rules
  rulesStructured   String   @default("{}") // JSON: structured rules data
  resolutionSource  String?  // e.g., "Australian Electoral Commission official results"

  // Pricing
  initialYesPrice   Float    @default(50)
  currentYesPrice   Float    @default(50)
  currentNoPrice    Float    @default(50)

  // Stats
  volume            Float    @default(0)
  liquidity         Float    @default(0)
  tradeCount        Int      @default(0)

  // Resolution
  resolvedOutcomeId String?
  resolvedAt        DateTime?
  settledAt         DateTime?

  // Metadata
  createdById       String?
  assignedToId      String?
  currentVersionId  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  category          Category          @relation(fields: [categoryId], references: [id])
  subcategory       Subcategory?      @relation(fields: [subcategoryId], references: [id])
  creator           AdminUser?        @relation("MarketCreator", fields: [createdById], references: [id])
  assignee          AdminUser?        @relation("MarketAssignee", fields: [assignedToId], references: [id])
  outcomes          MarketOutcome[]
  tags              MarketTag[]
  versions          MarketVersion[]
  approvals         MarketApproval[]
  relatedMarkets    MarketRelation[]  @relation("SourceMarket")
  relatedTo         MarketRelation[]  @relation("RelatedMarket")
  collections       MarketCollectionItem[]
  resolutions       MarketResolution[]
  auditLogs         AuditLog[]

  @@index([status])
  @@index([categoryId])
  @@index([closesAt])
  @@index([isFeatured])
  @@map("markets")
}

// ============================================================================
// MARKET OUTCOMES - Supports binary and multi-outcome
// ============================================================================

model MarketOutcome {
  id            String   @id @default(uuid())
  marketId      String

  // Outcome Info
  label         String   // e.g., "Yes", "No", "Labor", "Liberal", "Greens"
  displayLabel  String?  // Optional display override
  description   String?

  // For binary markets: position 0 = Yes, position 1 = No
  // For multi-outcome: order determines display position
  position      Int      @default(0)

  // Pricing (probability 0-100)
  currentPrice  Float    @default(50)
  initialPrice  Float    @default(50)

  // Color/styling
  color         String?  // Hex color for charts/display

  // Resolution
  isResolved    Boolean  @default(false)
  isWinner      Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  market        Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([marketId, position])
  @@map("market_outcomes")
}

// ============================================================================
// CATEGORIES & SUBCATEGORIES
// ============================================================================

model Category {
  id            String   @id @default(uuid())
  slug          String   @unique
  name          String
  description   String?
  icon          String?
  displayOrder  Int      @default(0)
  isActive      Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  subcategories Subcategory[]
  markets       Market[]

  @@map("categories")
}

model Subcategory {
  id            String   @id @default(uuid())
  categoryId    String
  slug          String
  name          String
  description   String?
  displayOrder  Int      @default(0)
  isActive      Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  category      Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  markets       Market[]

  @@unique([categoryId, slug])
  @@map("subcategories")
}

// ============================================================================
// TAGS
// ============================================================================

model Tag {
  id            String   @id @default(uuid())
  slug          String   @unique
  name          String
  description   String?
  color         String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  markets       MarketTag[]

  @@map("tags")
}

model MarketTag {
  id        String   @id @default(uuid())
  marketId  String
  tagId     String
  createdAt DateTime @default(now())

  // Relations
  market    Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([marketId, tagId])
  @@map("market_tags")
}

// ============================================================================
// MARKET VERSIONING - For rollbacks and history
// ============================================================================

model MarketVersion {
  id            String   @id @default(uuid())
  marketId      String
  version       Int

  // Snapshot of market data at this version
  data          String   // JSON snapshot of all market fields

  // Change info
  changeType    String   // created, updated, status_changed, resolved, etc.
  changeSummary String?

  // Who made the change
  createdById   String
  createdAt     DateTime @default(now())

  // Relations
  market        Market    @relation(fields: [marketId], references: [id], onDelete: Cascade)
  createdBy     AdminUser @relation(fields: [createdById], references: [id])

  @@unique([marketId, version])
  @@index([marketId])
  @@map("market_versions")
}

// ============================================================================
// MARKET APPROVALS - Workflow approvals
// ============================================================================

model MarketApproval {
  id            String   @id @default(uuid())
  marketId      String

  // Approval info
  fromStatus    String   // e.g., "draft"
  toStatus      String   // e.g., "review"
  action        String   // submitted, approved, rejected, needs_changes
  comments      String?

  // Who approved
  approvedById  String
  approvedAt    DateTime @default(now())

  // Relations
  market        Market    @relation(fields: [marketId], references: [id], onDelete: Cascade)
  approvedBy    AdminUser @relation(fields: [approvedById], references: [id])

  @@index([marketId])
  @@map("market_approvals")
}

// ============================================================================
// MARKET RESOLUTION
// ============================================================================

model MarketResolution {
  id              String   @id @default(uuid())
  marketId        String

  // Resolution details
  outcomeId       String?  // Which outcome won (for multi-outcome)
  resolution      String   // yes, no, void, or outcome label
  resolutionNotes String?
  sourceUrl       String?  // Evidence/source for resolution
  sourceData      String?  // JSON: structured source data

  // Who resolved
  resolvedById    String
  resolvedAt      DateTime @default(now())

  // Settlement
  settlementStatus String  @default("pending") // pending, processing, completed
  settledAt        DateTime?

  // Relations
  market          Market    @relation(fields: [marketId], references: [id], onDelete: Cascade)
  resolvedBy      AdminUser @relation(fields: [resolvedById], references: [id])

  @@index([marketId])
  @@map("market_resolutions")
}

// ============================================================================
// RELATED MARKETS - "People are also buying"
// ============================================================================

model MarketRelation {
  id              String   @id @default(uuid())
  sourceMarketId  String
  relatedMarketId String

  // Relation type
  relationType    String   @default("related") // related, similar, same_event, follow_up
  displayOrder    Int      @default(0)

  createdAt       DateTime @default(now())

  // Relations
  sourceMarket    Market   @relation("SourceMarket", fields: [sourceMarketId], references: [id], onDelete: Cascade)
  relatedMarket   Market   @relation("RelatedMarket", fields: [relatedMarketId], references: [id], onDelete: Cascade)

  @@unique([sourceMarketId, relatedMarketId])
  @@map("market_relations")
}

// ============================================================================
// MARKET COLLECTIONS
// ============================================================================

model MarketCollection {
  id            String   @id @default(uuid())
  slug          String   @unique
  name          String
  description   String?
  heroImageUrl  String?

  // Display
  displayOrder  Int      @default(0)
  isActive      Boolean  @default(true)
  isFeatured    Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  markets       MarketCollectionItem[]

  @@map("market_collections")
}

model MarketCollectionItem {
  id            String   @id @default(uuid())
  collectionId  String
  marketId      String
  displayOrder  Int      @default(0)

  createdAt     DateTime @default(now())

  // Relations
  collection    MarketCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  market        Market           @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([collectionId, marketId])
  @@map("market_collection_items")
}

// ============================================================================
// AUDIT LOGGING - Legacy table (kept for backward compatibility)
// ============================================================================

model AuditLog {
  id            String   @id @default(uuid())

  // Who
  userId        String?
  userEmail     String?
  ipAddress     String?
  userAgent     String?

  // What
  entityType    String   // market, category, tag, admin_user, etc.
  entityId      String?
  action        String   // create, update, delete, approve, reject, resolve, etc.

  // Details
  previousData  String?  // JSON: before state
  newData       String?  // JSON: after state
  metadata      String?  // JSON: additional context

  createdAt     DateTime @default(now())

  // Relations
  user          AdminUser? @relation(fields: [userId], references: [id])
  market        Market?    @relation(fields: [entityId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================================
// AUDIT EVENT - Comprehensive append-only event log for regulatory compliance
// ============================================================================

model AuditEvent {
  id                String   @id @default(uuid())

  // Timing - UTC millisecond precision with monotonic sequence
  occurredAt        DateTime @default(now())      // UTC timestamp
  occurredAtMs      BigInt                        // Millisecond timestamp for precise ordering
  seq               BigInt   @default(autoincrement()) // Monotonic sequence for strict ordering

  // Event classification
  eventType         String   // Enum: USER_LOGIN_SUCCESS, MARKET_CREATED, ORDER_PLACED, etc.

  // Actor identification
  actorType         String   // user, admin, system
  actorId           String?  // User or admin ID
  actorKycRef       String?  // KYC reference (never store raw PII)
  sessionId         String?  // Session ID for correlation

  // Request context
  requestId         String?  // Correlation ID for request tracing
  ipAddress         String?  // Client IP
  userAgent         String?  // Browser/client info
  deviceFingerprint String?  // Device fingerprint hash
  geo               String?  // JSON: { country, region, city } best-effort

  // Entity references
  marketId          String?  // Market ID if applicable
  betId             String?  // Bet/Order ID if applicable
  tradeId           String?  // Trade ID if applicable
  orderId           String?  // Order ID if applicable

  // Versioning
  rulesVersion      Int?     // Market rules version at time of event
  pricingVersion    Int?     // Pricing/AMM formula version

  // Admin/compliance fields
  reasonCode        String?  // Required for admin actions (e.g., COMPLIANCE_REVIEW, USER_REQUEST)

  // State snapshots (JSON - lightweight critical fields only)
  beforeState       String?  // JSON: state before mutation
  afterState        String?  // JSON: state after mutation

  // Freeform metadata
  metadata          String?  // JSON: additional context

  // Tamper evidence - hash chaining
  integrityHash     String?  // SHA-256 hash of canonical payload + previous hash
  previousHash      String?  // Hash of previous event for chain verification

  // Retention
  retentionPolicy   String   @default("7_years") // Retention period

  createdAt         DateTime @default(now())

  @@index([eventType])
  @@index([actorType, actorId])
  @@index([marketId])
  @@index([betId])
  @@index([orderId])
  @@index([occurredAt])
  @@index([seq])
  @@index([requestId])
  @@map("audit_events")
}

// ============================================================================
// SYSTEM SEQUENCE - Global sequence counter for audit events
// ============================================================================

model SystemSequence {
  id        String @id @default("audit_seq")
  lastSeq   BigInt @default(0)
  updatedAt DateTime @updatedAt

  @@map("system_sequences")
}

// ============================================================================
// TRADING CONSTRAINTS TEMPLATE - Reusable constraint sets
// ============================================================================

model ConstraintTemplate {
  id            String   @id @default(uuid())
  name          String
  description   String?

  // Constraints (JSON)
  constraints   String   // JSON with all constraint fields

  isDefault     Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("constraint_templates")
}

// ============================================================================
// SESSIONS - For NextAuth
// ============================================================================

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  @@map("sessions")
}

// ============================================================================
// GROUP CHATS - Social features
// ============================================================================

model GroupChat {
  id            String    @id @default(uuid())
  name          String
  description   String?
  emoji         String    @default("💬")
  createdById   String
  isActive      Boolean   @default(true)
  maxMembers    Int       @default(20)
  inviteCode    String    @unique @default(uuid())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  createdBy     User              @relation("ChatCreator", fields: [createdById], references: [id])
  members       GroupChatMember[]
  messages      ChatMessage[]
  predictions   SharedPrediction[]

  @@map("group_chats")
}

model GroupChatMember {
  id          String    @id @default(uuid())
  chatId      String
  userId      String
  isAdmin     Boolean   @default(false)
  isMuted     Boolean   @default(false)
  joinedAt    DateTime  @default(now())
  lastReadAt  DateTime  @default(now())

  // Relations
  chat        GroupChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@map("group_chat_members")
}

model ChatMessage {
  id          String    @id @default(uuid())
  chatId      String
  senderId    String
  content     String
  isPinned    Boolean   @default(false)
  predictionId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  chat        GroupChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender      User      @relation(fields: [senderId], references: [id])
  prediction  SharedPrediction? @relation(fields: [predictionId], references: [id])

  @@index([chatId])
  @@index([senderId])
  @@map("chat_messages")
}

model SharedPrediction {
  id          String    @id @default(uuid())
  chatId      String
  userId      String
  market      String
  position    String    // 'Yes' or 'No'
  amount      Float
  description String?
  createdAt   DateTime  @default(now())

  // Relations
  chat        GroupChat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id])
  messages    ChatMessage[]

  @@index([chatId])
  @@index([userId])
  @@map("shared_predictions")
}

// ============================================================================
// USER FOLLOWS - Social graph
// ============================================================================

model UserFollow {
  id          String    @id @default(uuid())
  followerId  String    // User who is following
  followingId String    // User being followed
  createdAt   DateTime  @default(now())

  // Relations
  follower    User      @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User      @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("user_follows")
}
