// Prisma schema for MarketOps Admin System
// Supports full market lifecycle, multi-outcome markets, constraints, audit logging, etc.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// PUBLIC USERS & AUTHENTICATION
// ============================================================================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  username      String    @unique
  passwordHash  String
  firstName     String?
  lastName      String?
  displayName   String?
  avatarUrl     String?
  isActive      Boolean   @default(true)
  isVerified    Boolean   @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Trading stats - ALL IN INTEGER CENTS for precision
  balanceCents      BigInt    @default(0) // Balance in cents (100 = $1.00)
  lockedBalanceCents BigInt   @default(0) // Balance locked in open orders
  totalProfitCents  BigInt    @default(0) // Cumulative profit in cents
  totalTrades       Int       @default(0)
  totalVolumeCents  BigInt    @default(0) // Total volume in cents

  // Sharp Shield V2 - Fee Tracking
  totalTakerFeesPaidCents BigInt @default(0)
  totalMakerRebatesEarnedCents BigInt @default(0)
  netFeesCents      BigInt    @default(0) // takerFees - makerRebates

  // Legacy float fields (deprecated, kept for migration)
  balance       Float     @default(0)
  totalProfit   Float     @default(0)
  totalVolume   Float     @default(0)

  // Risk scoring & Sharp Shield
  riskScore     Int       @default(0) // 0-100, higher = more risky
  isFlagged     Boolean   @default(false)
  flagReason    String?
  riskLevel     String    @default("low") // low, medium, high, toxic
  toxicFlowCount Int      @default(0)     // Count of toxic flow incidents

  // Account Status & Risk Controls
  accountStatus String    @default("active") // active, frozen, suspended, banned
  statusReason  String?
  statusChangedAt DateTime?
  statusChangedBy String?  // AdminUser ID who changed status
  customMaxBetCents BigInt?  // Manual limit override (null = use tier default)
  sharpShieldTierOverride Int?  // Force specific tier (null = auto)

  // KYC / Compliance (NT Regulatory)
  kycStatus     String    @default("pending") // pending, submitted, verified, failed, expired
  kycProvider   String?   // e.g., "greenid", "jumio"
  kycVerifiedAt DateTime?
  kycReferenceId String?
  kycDocumentType String? // passport, drivers_license, etc.
  kycExpiresAt  DateTime?

  // Responsible Gambling (NT Requirements)
  depositLimitCents    BigInt?   // Self-imposed deposit limit
  depositLimitPeriod   String?   // daily, weekly, monthly
  depositLimitResetAt  DateTime?
  currentPeriodDepositsCents BigInt @default(0)
  selfExclusionUntil   DateTime? // Voluntary self-exclusion
  coolingOffUntil      DateTime? // Cooling off period
  activityStatementOptIn Boolean @default(true)
  lastActivityStatementAt DateTime?

  // Session / Device Tracking
  lastIpAddress     String?
  lastDeviceFingerprint String?
  lastUserAgent     String?

  // Relations - Chats
  createdChats      GroupChat[]         @relation("ChatCreator")
  chatMemberships   GroupChatMember[]
  chatMessages      ChatMessage[]
  sharedPredictions SharedPrediction[]

  // Relations - Social
  followers         UserFollow[]        @relation("UserFollowing")
  following         UserFollow[]        @relation("UserFollowers")

  // Relations - Trading (Fortress Engine)
  orders            Order[]
  positions         Position[]
  buyTrades         Trade[]             @relation("BuyerTrades")
  sellTrades        Trade[]             @relation("SellerTrades")
  liquidityRewards  LiquidityReward[]
  dmmMetrics        DMMMetrics[]
  dmmRegistration   DMMRegistration?
  riskEvents        RiskEvent[]
  marketMakerBots   MarketMakerBot[]
  settlementPayouts SettlementPayout[]

  // Relations - Compliance & Admin
  sessions          UserSession[]
  balanceAdjustments BalanceAdjustment[]
  activityStatements ActivityStatement[]

  // Relations - Social Content & Moderation
  marketComments    MarketComment[]
  communityPosts    CommunityPost[]
  contentReports    ContentReport[]     @relation("ReportedBy")
  reportsAgainst    ContentReport[]     @relation("ReportedUser")

  // Off-Mark Social Moderation
  offMarkStatus     String    @default("good_standing") // good_standing, warning, restricted, banned
  offMarkUntil      DateTime? // null = permanent if banned, or end of restriction
  offMarkReason     String?
  offMarkCount      Int       @default(0) // Number of times marked Off-Mark
  offMarkLastAt     DateTime?
  offMarkByAdminId  String?   // AdminUser who applied the restriction
  canComment        Boolean   @default(true)
  canPost           Boolean   @default(true)
  canChat           Boolean   @default(true)

  @@map("users")
}

// User Session Tracking (IP & Device Fingerprinting)
model UserSession {
  id              String    @id @default(uuid())
  userId          String
  ipAddress       String
  deviceFingerprint String?
  userAgent       String?
  country         String?
  city            String?
  createdAt       DateTime  @default(now())
  lastActiveAt    DateTime  @default(now())
  isActive        Boolean   @default(true)

  user            User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([ipAddress])
  @@index([deviceFingerprint])
  @@map("user_sessions")
}

// Balance Adjustments (for manual credits/debits with audit trail)
model BalanceAdjustment {
  id              String    @id @default(uuid())
  userId          String
  adminUserId     String
  amountCents     BigInt    // Positive = credit, Negative = debit
  type            String    // credit, debit, refund, bonus, correction
  reason          String    // Required note for audit
  balanceBeforeCents BigInt
  balanceAfterCents BigInt
  createdAt       DateTime  @default(now())

  user            User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([adminUserId])
  @@map("balance_adjustments")
}

// Activity Statements (NT Regulatory monthly reports)
model ActivityStatement {
  id              String    @id @default(uuid())
  userId          String
  periodStart     DateTime
  periodEnd       DateTime
  totalDepositsCents BigInt
  totalWithdrawalsCents BigInt
  totalWinsCents  BigInt
  totalLossesCents BigInt
  netResultCents  BigInt
  totalTradeCount Int
  generatedAt     DateTime  @default(now())
  pdfUrl          String?

  user            User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("activity_statements")
}

// ============================================================================
// SOCIAL CONTENT & MODERATION (Off-Mark System)
// ============================================================================

// Comments on market pages
model MarketComment {
  id            String    @id @default(uuid())
  marketId      String
  userId        String
  content       String
  isHidden      Boolean   @default(false) // Hidden by moderation
  hiddenReason  String?
  hiddenByAdminId String?
  reportsCount  Int       @default(0)
  likesCount    Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  market        Market    @relation(fields: [marketId], references: [id])
  user          User      @relation(fields: [userId], references: [id])
  reports       ContentReport[] @relation("CommentReports")

  @@index([marketId])
  @@index([userId])
  @@index([createdAt])
  @@map("market_comments")
}

// Community feed posts
model CommunityPost {
  id            String    @id @default(uuid())
  userId        String
  content       String
  category      String?   // Politics, Economics, Sport, etc.
  linkedMarketId String?  // Optional linked market
  isHidden      Boolean   @default(false)
  hiddenReason  String?
  hiddenByAdminId String?
  reportsCount  Int       @default(0)
  likesCount    Int       @default(0)
  commentsCount Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id])
  linkedMarket  Market?   @relation(fields: [linkedMarketId], references: [id])
  reports       ContentReport[] @relation("PostReports")

  @@index([userId])
  @@index([category])
  @@index([createdAt])
  @@map("community_posts")
}

// Content reports for moderation queue
model ContentReport {
  id              String    @id @default(uuid())
  reporterId      String    // User who filed the report
  reportedUserId  String    // User being reported
  contentType     String    // market_comment, community_post, chat_message
  contentId       String    // ID of the reported content
  reason          String    // harassment, hate_speech, spam, inappropriate, other
  description     String?   // Optional additional details
  status          String    @default("pending") // pending, reviewed, actioned, dismissed
  reviewedByAdminId String?
  reviewedAt      DateTime?
  actionTaken     String?   // warning, content_hidden, off_mark_temp, off_mark_perm
  adminNotes      String?
  createdAt       DateTime  @default(now())

  reporter        User      @relation("ReportedBy", fields: [reporterId], references: [id])
  reportedUser    User      @relation("ReportedUser", fields: [reportedUserId], references: [id])
  comment         MarketComment? @relation("CommentReports", fields: [contentId], references: [id], map: "comment_reports")
  post            CommunityPost? @relation("PostReports", fields: [contentId], references: [id], map: "post_reports")

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([status])
  @@index([createdAt])
  @@map("content_reports")
}

// ============================================================================
// ADMIN USERS & AUTHENTICATION
// ============================================================================

model AdminUser {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          String    @default("operator") // super_admin, admin, operator, viewer
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  marketVersions    MarketVersion[]
  approvals         MarketApproval[]
  auditLogs         AuditLog[]
  createdMarkets    Market[]          @relation("MarketCreator")
  assignedMarkets   Market[]          @relation("MarketAssignee")
  resolutions       MarketResolution[]

  // Relations - Fortress Trading Engine
  dmmApprovals      DMMRegistration[]
  resolvedRiskEvents RiskEvent[]
  processedSettlements SettlementRecord[]

  @@map("admin_users")
}

// ============================================================================
// MARKETS - Core entity
// ============================================================================

model Market {
  id                String   @id @default(uuid())
  slug              String   @unique

  // Basic Info
  title             String
  shortDescription  String   // For market cards
  description       String   // Full description (supports markdown)

  // Status & Workflow
  status            String   @default("draft") // draft, review, approved, published, trading_halted, resolved, settled, archived

  // Category & Organization
  categoryId        String
  subcategoryId     String?
  isFeatured        Boolean  @default(false)
  featuredOrder     Int?

  // Display Info (Market Card)
  icon              String?  // Emoji or icon name
  heroImageUrl      String?
  cardImageUrl      String?

  // Market Type
  marketType        String   @default("binary") // binary, multi_outcome

  // Dates & Timezone
  timezone          String   @default("Australia/Sydney")
  opensAt           DateTime?
  closesAt          DateTime
  resolvesBy        DateTime
  settlesBy         DateTime

  // Trading Constraints (stored as JSON)
  constraints       String   @default("{}") // JSON: min/max trade, position limits, etc.

  // Rules
  rulesText         String   // Human readable rules
  rulesStructured   String   @default("{}") // JSON: structured rules data
  resolutionSource  String?  // e.g., "Australian Electoral Commission official results"

  // Pricing
  initialYesPrice   Float    @default(50)
  currentYesPrice   Float    @default(50)
  currentNoPrice    Float    @default(50)

  // Stats
  volume            Float    @default(0)
  liquidity         Float    @default(0)
  tradeCount        Int      @default(0)

  // Resolution
  resolvedOutcomeId String?
  resolvedAt        DateTime?
  settledAt         DateTime?

  // Sharp Shield V2 - Oracle Lock State
  isOracleLocked    Boolean   @default(false)
  oracleLockReason  String?   // MATCH_STARTED, OFFICIAL_RESULT, VOLATILITY, ADMIN_HALT, FEED_FAILURE, DEADMAN_SWITCH
  oracleLockedAt    DateTime?
  oracleExternalEventId String? // External event reference

  // Metadata
  createdById       String?
  assignedToId      String?
  currentVersionId  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  category          Category          @relation(fields: [categoryId], references: [id])
  subcategory       Subcategory?      @relation(fields: [subcategoryId], references: [id])
  creator           AdminUser?        @relation("MarketCreator", fields: [createdById], references: [id])
  assignee          AdminUser?        @relation("MarketAssignee", fields: [assignedToId], references: [id])
  outcomes          MarketOutcome[]
  tags              MarketTag[]
  versions          MarketVersion[]
  approvals         MarketApproval[]
  relatedMarkets    MarketRelation[]  @relation("SourceMarket")
  relatedTo         MarketRelation[]  @relation("RelatedMarket")
  collections       MarketCollectionItem[]
  resolutions       MarketResolution[]
  auditLogs         AuditLog[]

  // Relations - Fortress Trading Engine
  orders            Order[]
  trades            Trade[]
  positions         Position[]
  liquidityRewards  LiquidityReward[]
  dmmMetrics        DMMMetrics[]
  riskEvents        RiskEvent[]
  liquidityState    MarketLiquidityState?
  settlementRecords SettlementRecord[]
  oracleLockState   OracleLockState?
  oracleEvents      OracleEvent[]
  pendingOrders     PendingOrder[]
  batchExecutions   BatchExecution[]

  // Relations - Social Content
  comments          MarketComment[]
  linkedPosts       CommunityPost[]

  @@index([status])
  @@index([isOracleLocked])
  @@index([categoryId])
  @@index([closesAt])
  @@index([isFeatured])
  @@map("markets")
}

// ============================================================================
// MARKET OUTCOMES - Supports binary and multi-outcome
// ============================================================================

model MarketOutcome {
  id            String   @id @default(uuid())
  marketId      String

  // Outcome Info
  label         String   // e.g., "Yes", "No", "Labor", "Liberal", "Greens"
  displayLabel  String?  // Optional display override
  description   String?

  // For binary markets: position 0 = Yes, position 1 = No
  // For multi-outcome: order determines display position
  position      Int      @default(0)

  // Pricing (probability 0-100) - CENTS for integer precision
  currentPriceCents Int  @default(50) // Price in cents (1-99)
  initialPriceCents Int  @default(50)

  // Legacy float prices (deprecated)
  currentPrice  Float    @default(50)
  initialPrice  Float    @default(50)

  // Color/styling
  color         String?  // Hex color for charts/display
  imageUrl      String?  // Outcome image URL (e.g., movie poster, candidate photo)

  // Resolution
  isResolved    Boolean  @default(false)
  isWinner      Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  market        Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)

  // Relations - Fortress Trading Engine
  orders        Order[]
  trades        Trade[]
  positions     Position[]

  @@unique([marketId, position])
  @@map("market_outcomes")
}

// ============================================================================
// CATEGORIES & SUBCATEGORIES
// ============================================================================

model Category {
  id            String   @id @default(uuid())
  slug          String   @unique
  name          String
  description   String?
  icon          String?
  displayOrder  Int      @default(0)
  isActive      Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  subcategories Subcategory[]
  markets       Market[]

  @@map("categories")
}

model Subcategory {
  id            String   @id @default(uuid())
  categoryId    String
  slug          String
  name          String
  description   String?
  displayOrder  Int      @default(0)
  isActive      Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  category      Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  markets       Market[]

  @@unique([categoryId, slug])
  @@map("subcategories")
}

// ============================================================================
// TAGS
// ============================================================================

model Tag {
  id            String   @id @default(uuid())
  slug          String   @unique
  name          String
  description   String?
  color         String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  markets       MarketTag[]

  @@map("tags")
}

model MarketTag {
  id        String   @id @default(uuid())
  marketId  String
  tagId     String
  createdAt DateTime @default(now())

  // Relations
  market    Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([marketId, tagId])
  @@map("market_tags")
}

// ============================================================================
// MARKET VERSIONING - For rollbacks and history
// ============================================================================

model MarketVersion {
  id            String   @id @default(uuid())
  marketId      String
  version       Int

  // Snapshot of market data at this version
  data          String   // JSON snapshot of all market fields

  // Change info
  changeType    String   // created, updated, status_changed, resolved, etc.
  changeSummary String?

  // Who made the change
  createdById   String
  createdAt     DateTime @default(now())

  // Relations
  market        Market    @relation(fields: [marketId], references: [id], onDelete: Cascade)
  createdBy     AdminUser @relation(fields: [createdById], references: [id])

  @@unique([marketId, version])
  @@index([marketId])
  @@map("market_versions")
}

// ============================================================================
// MARKET APPROVALS - Workflow approvals
// ============================================================================

model MarketApproval {
  id            String   @id @default(uuid())
  marketId      String

  // Approval info
  fromStatus    String   // e.g., "draft"
  toStatus      String   // e.g., "review"
  action        String   // submitted, approved, rejected, needs_changes
  comments      String?

  // Who approved
  approvedById  String
  approvedAt    DateTime @default(now())

  // Relations
  market        Market    @relation(fields: [marketId], references: [id], onDelete: Cascade)
  approvedBy    AdminUser @relation(fields: [approvedById], references: [id])

  @@index([marketId])
  @@map("market_approvals")
}

// ============================================================================
// MARKET RESOLUTION
// ============================================================================

model MarketResolution {
  id              String   @id @default(uuid())
  marketId        String

  // Resolution details
  outcomeId       String?  // Which outcome won (for multi-outcome)
  resolution      String   // yes, no, void, or outcome label
  resolutionNotes String?
  sourceUrl       String?  // Evidence/source for resolution
  sourceData      String?  // JSON: structured source data

  // Who resolved
  resolvedById    String
  resolvedAt      DateTime @default(now())

  // Settlement
  settlementStatus String  @default("pending") // pending, processing, completed
  settledAt        DateTime?

  // Relations
  market          Market    @relation(fields: [marketId], references: [id], onDelete: Cascade)
  resolvedBy      AdminUser @relation(fields: [resolvedById], references: [id])

  @@index([marketId])
  @@map("market_resolutions")
}

// ============================================================================
// RELATED MARKETS - "People are also buying"
// ============================================================================

model MarketRelation {
  id              String   @id @default(uuid())
  sourceMarketId  String
  relatedMarketId String

  // Relation type
  relationType    String   @default("related") // related, similar, same_event, follow_up
  displayOrder    Int      @default(0)

  createdAt       DateTime @default(now())

  // Relations
  sourceMarket    Market   @relation("SourceMarket", fields: [sourceMarketId], references: [id], onDelete: Cascade)
  relatedMarket   Market   @relation("RelatedMarket", fields: [relatedMarketId], references: [id], onDelete: Cascade)

  @@unique([sourceMarketId, relatedMarketId])
  @@map("market_relations")
}

// ============================================================================
// MARKET COLLECTIONS
// ============================================================================

model MarketCollection {
  id            String   @id @default(uuid())
  slug          String   @unique
  name          String
  description   String?
  heroImageUrl  String?

  // Display
  displayOrder  Int      @default(0)
  isActive      Boolean  @default(true)
  isFeatured    Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  markets       MarketCollectionItem[]

  @@map("market_collections")
}

model MarketCollectionItem {
  id            String   @id @default(uuid())
  collectionId  String
  marketId      String
  displayOrder  Int      @default(0)

  createdAt     DateTime @default(now())

  // Relations
  collection    MarketCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  market        Market           @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([collectionId, marketId])
  @@map("market_collection_items")
}

// ============================================================================
// AUDIT LOGGING - Legacy table (kept for backward compatibility)
// ============================================================================

model AuditLog {
  id            String   @id @default(uuid())

  // Who
  userId        String?
  userEmail     String?
  ipAddress     String?
  userAgent     String?

  // What
  entityType    String   // market, category, tag, admin_user, etc.
  entityId      String?
  action        String   // create, update, delete, approve, reject, resolve, etc.

  // Details
  previousData  String?  // JSON: before state
  newData       String?  // JSON: after state
  metadata      String?  // JSON: additional context

  createdAt     DateTime @default(now())

  // Relations
  user          AdminUser? @relation(fields: [userId], references: [id])
  market        Market?    @relation(fields: [entityId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================================
// AUDIT EVENT - Comprehensive append-only event log for regulatory compliance
// ============================================================================

model AuditEvent {
  id                String   @id @default(uuid())

  // Timing - UTC millisecond precision with monotonic sequence
  occurredAt        DateTime @default(now())      // UTC timestamp
  occurredAtMs      BigInt                        // Millisecond timestamp for precise ordering
  seq               BigInt   @default(autoincrement()) // Monotonic sequence for strict ordering

  // Event classification
  eventType         String   // Enum: USER_LOGIN_SUCCESS, MARKET_CREATED, ORDER_PLACED, etc.

  // Actor identification
  actorType         String   // user, admin, system
  actorId           String?  // User or admin ID
  actorKycRef       String?  // KYC reference (never store raw PII)
  sessionId         String?  // Session ID for correlation

  // Request context
  requestId         String?  // Correlation ID for request tracing
  ipAddress         String?  // Client IP
  userAgent         String?  // Browser/client info
  deviceFingerprint String?  // Device fingerprint hash
  geo               String?  // JSON: { country, region, city } best-effort

  // Entity references
  marketId          String?  // Market ID if applicable
  betId             String?  // Bet/Order ID if applicable
  tradeId           String?  // Trade ID if applicable
  orderId           String?  // Order ID if applicable

  // Sharp Shield V2 - Batch References
  batchId           String?  // Batch execution ID
  batchSequenceNumber BigInt? // Sequence number within batch

  // Versioning
  rulesVersion      Int?     // Market rules version at time of event
  pricingVersion    Int?     // Pricing/AMM formula version

  // Admin/compliance fields
  reasonCode        String?  // Required for admin actions (e.g., COMPLIANCE_REVIEW, USER_REQUEST)

  // State snapshots (JSON - lightweight critical fields only)
  beforeState       String?  // JSON: state before mutation
  afterState        String?  // JSON: state after mutation

  // Freeform metadata
  metadata          String?  // JSON: additional context

  // Tamper evidence - hash chaining
  integrityHash     String?  // SHA-256 hash of canonical payload + previous hash
  previousHash      String?  // Hash of previous event for chain verification

  // Retention
  retentionPolicy   String   @default("7_years") // Retention period

  createdAt         DateTime @default(now())

  @@index([eventType])
  @@index([actorType, actorId])
  @@index([marketId])
  @@index([betId])
  @@index([orderId])
  @@index([occurredAt])
  @@index([seq])
  @@index([requestId])
  @@index([batchId])
  @@map("audit_events")
}

// ============================================================================
// SYSTEM SEQUENCE - Global sequence counter for audit events
// ============================================================================

model SystemSequence {
  id        String @id @default("audit_seq")
  lastSeq   BigInt @default(0)
  updatedAt DateTime @updatedAt

  @@map("system_sequences")
}

// ============================================================================
// TRADING CONSTRAINTS TEMPLATE - Reusable constraint sets
// ============================================================================

model ConstraintTemplate {
  id            String   @id @default(uuid())
  name          String
  description   String?

  // Constraints (JSON)
  constraints   String   // JSON with all constraint fields

  isDefault     Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("constraint_templates")
}

// ============================================================================
// SESSIONS - For NextAuth
// ============================================================================

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  @@map("sessions")
}

// ============================================================================
// GROUP CHATS - Social features
// ============================================================================

model GroupChat {
  id            String    @id @default(uuid())
  name          String
  description   String?
  emoji         String    @default("💬")
  createdById   String
  isActive      Boolean   @default(true)
  maxMembers    Int       @default(20)
  inviteCode    String    @unique @default(uuid())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  createdBy     User              @relation("ChatCreator", fields: [createdById], references: [id])
  members       GroupChatMember[]
  messages      ChatMessage[]
  predictions   SharedPrediction[]

  @@map("group_chats")
}

model GroupChatMember {
  id          String    @id @default(uuid())
  chatId      String
  userId      String
  isAdmin     Boolean   @default(false)
  isMuted     Boolean   @default(false)
  joinedAt    DateTime  @default(now())
  lastReadAt  DateTime  @default(now())

  // Relations
  chat        GroupChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@map("group_chat_members")
}

model ChatMessage {
  id          String    @id @default(uuid())
  chatId      String
  senderId    String
  content     String
  isPinned    Boolean   @default(false)
  predictionId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  chat        GroupChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender      User      @relation(fields: [senderId], references: [id])
  prediction  SharedPrediction? @relation(fields: [predictionId], references: [id])

  @@index([chatId])
  @@index([senderId])
  @@map("chat_messages")
}

model SharedPrediction {
  id          String    @id @default(uuid())
  chatId      String
  userId      String
  market      String
  position    String    // 'Yes' or 'No'
  amount      Float
  description String?
  createdAt   DateTime  @default(now())

  // Relations
  chat        GroupChat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id])
  messages    ChatMessage[]

  @@index([chatId])
  @@index([userId])
  @@map("shared_predictions")
}

// ============================================================================
// USER FOLLOWS - Social graph
// ============================================================================

model UserFollow {
  id          String    @id @default(uuid())
  followerId  String    // User who is following
  followingId String    // User being followed
  createdAt   DateTime  @default(now())

  // Relations
  follower    User      @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User      @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("user_follows")
}

// ============================================================================
// FORTRESS TRADING ENGINE - NT 2024 Compliant CLOB
// ============================================================================

// ============================================================================
// ORDERS - Central Limit Order Book (CLOB)
// All prices in INTEGER CENTS (100 = $1.00) to avoid floating point errors
// ============================================================================

model Order {
  id              String    @id @default(uuid())

  // Market & Outcome
  marketId        String
  outcomeId       String    // Which outcome (Yes/No or multi-outcome)

  // User
  userId          String

  // Order Details - ALL PRICES IN INTEGER CENTS
  side            String    // 'buy' or 'sell'
  orderType       String    // 'limit' or 'market'
  priceCents      Int       // Price in cents (1-99 for binary, P_yes + P_no must = 100)
  quantityCents   Int       // Total quantity in cents
  filledCents     Int       @default(0) // Amount filled in cents
  remainingCents  Int       // Amount remaining (quantityCents - filledCents)

  // Order Status
  status          String    @default("pending") // pending, open, partial, filled, cancelled, expired, rejected

  // Timing - Price-Time Priority
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  expiresAt       DateTime? // Optional expiration
  filledAt        DateTime? // When fully filled
  cancelledAt     DateTime? // When cancelled

  // Taker vs Maker designation
  isTaker         Boolean   @default(false) // True if matched against existing liquidity

  // NT Audit Requirements
  reasonCode      String?   // CLOB_MATCH, USER_CANCEL, EXPIRED, ADMIN_CANCEL, etc.
  ipAddress       String?
  deviceFingerprint String?

  // Risk flags
  isFlagged       Boolean   @default(false)
  flagReason      String?

  // Relations
  user            User      @relation(fields: [userId], references: [id])
  market          Market    @relation(fields: [marketId], references: [id])
  outcome         MarketOutcome @relation(fields: [outcomeId], references: [id])

  // Trade relations
  buyTrades       Trade[]   @relation("BuyerOrders")
  sellTrades      Trade[]   @relation("SellerOrders")

  @@index([marketId, outcomeId, status])
  @@index([marketId, side, priceCents, createdAt]) // CLOB index for price-time priority
  @@index([userId, status])
  @@index([status, createdAt])
  @@index([expiresAt])
  @@map("orders")
}

// ============================================================================
// TAKER QUEUE - 500ms Processing Delay for Fair Look
// Implements mandatory delay for taker orders to prevent latency arbitrage
// ============================================================================

model TakerQueue {
  id              String    @id @default(uuid())
  orderId         String    @unique

  // Timing
  queuedAt        DateTime  @default(now())
  releaseAt       DateTime  // queuedAt + 500ms
  processedAt     DateTime?

  // Status
  status          String    @default("queued") // queued, processing, completed, cancelled

  // Order snapshot (in case order is modified)
  orderSnapshot   String    // JSON snapshot of order at queue time

  // Processing result
  matchResult     String?   // JSON result of matching attempt
  errorMessage    String?

  @@index([releaseAt, status])
  @@index([status])
  @@map("taker_queue")
}

// ============================================================================
// TRADES - Executed Matches
// ============================================================================

model Trade {
  id              String    @id @default(uuid())

  // Market & Outcome
  marketId        String
  outcomeId       String

  // Matched Orders
  buyOrderId      String
  sellOrderId     String
  buyerId         String
  sellerId        String

  // Trade Details - ALL IN INTEGER CENTS
  priceCents      Int       // Execution price in cents
  quantityCents   Int       // Trade size in cents

  // Fees (in cents)
  buyerFeeCents   Int       @default(0)
  sellerFeeCents  Int       @default(0)

  // Execution timing
  executedAt      DateTime  @default(now())

  // NT Audit Trail
  reasonCode      String    @default("CLOB_MATCH") // CLOB_MATCH, MM_FILL, AUCTION, etc.

  // Sharp Shield V2 - Batch Reference
  batchId         String?   // Reference to batch_executions
  batchSequenceNumber BigInt? // Sequence within batch for replay

  // Sharp Shield V2 - Fee Details
  takerSide       String?   // BID or ASK - which side was taker
  makerRebateCents Int      @default(0)
  venueFeeNetCents Int      @default(0)
  liquidityTierAtExecution Int @default(0)

  // Relations
  market          Market    @relation(fields: [marketId], references: [id])
  outcome         MarketOutcome @relation(fields: [outcomeId], references: [id])
  buyOrder        Order     @relation("BuyerOrders", fields: [buyOrderId], references: [id])
  sellOrder       Order     @relation("SellerOrders", fields: [sellOrderId], references: [id])
  buyer           User      @relation("BuyerTrades", fields: [buyerId], references: [id])
  seller          User      @relation("SellerTrades", fields: [sellerId], references: [id])

  @@index([marketId, executedAt])
  @@index([buyerId])
  @@index([sellerId])
  @@index([executedAt])
  @@index([batchId])
  @@map("trades")
}

// ============================================================================
// POSITIONS - User Holdings per Market/Outcome
// ============================================================================

model Position {
  id              String    @id @default(uuid())

  userId          String
  marketId        String
  outcomeId       String

  // Position Details - ALL IN INTEGER CENTS
  quantityCents   Int       @default(0) // Net position (positive = long, negative = short)
  avgPriceCents   Int       @default(0) // Average entry price in cents
  totalCostCents  Int       @default(0) // Total cost basis in cents

  // Realized P&L tracking
  realizedPnlCents Int      @default(0)

  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  user            User      @relation(fields: [userId], references: [id])
  market          Market    @relation(fields: [marketId], references: [id])
  outcome         MarketOutcome @relation(fields: [outcomeId], references: [id])

  // Settlement
  settlementPayouts SettlementPayout[]

  @@unique([userId, marketId, outcomeId])
  @@index([userId])
  @@index([marketId])
  @@map("positions")
}

// ============================================================================
// LIQUIDITY REWARDS - LIP (Liquidity Incentive Program)
// Tracks Time-Weighted Liquidity for rebate calculations
// ============================================================================

model LiquidityReward {
  id              String    @id @default(uuid())

  userId          String
  marketId        String

  // Time-Weighted Liquidity Metrics
  twlPoints       BigInt    @default(0) // Total TWL points accumulated

  // Tracking period
  periodStart     DateTime
  periodEnd       DateTime

  // Snapshot data for verification
  avgLiquidityCents BigInt  @default(0) // Average liquidity provided in cents
  timeInSpreadMs  BigInt    @default(0) // Time with orders within 2% of mid
  totalOrdersTracked Int    @default(0) // Number of orders tracked

  // Rebate calculation
  rebateEarnedCents Int     @default(0) // Rebate earned in cents
  rebatePaidAt    DateTime?

  // Status
  status          String    @default("active") // active, calculated, paid

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  user            User      @relation(fields: [userId], references: [id])
  market          Market    @relation(fields: [marketId], references: [id])

  @@index([userId, periodStart])
  @@index([marketId, periodStart])
  @@index([status])
  @@map("liquidity_rewards")
}

// ============================================================================
// DMM METRICS - Designated Market Maker Monitoring
// ============================================================================

model DMMMetrics {
  id              String    @id @default(uuid())

  userId          String    // DMM user ID
  marketId        String

  // Uptime tracking
  periodStart     DateTime
  periodEnd       DateTime
  uptimeMs        BigInt    @default(0) // Total uptime in milliseconds
  downtimeMs      BigInt    @default(0) // Total downtime
  uptimePercent   Float     @default(0) // Calculated uptime percentage

  // Spread consistency
  avgSpreadCents  Int       @default(0) // Average spread in cents
  maxSpreadCents  Int       @default(0) // Maximum spread observed
  minSpreadCents  Int       @default(0) // Minimum spread observed
  spreadViolations Int      @default(0) // Times spread exceeded threshold

  // Volume metrics
  volumeProvidedCents BigInt @default(0) // Total volume provided
  tradesMatched   Int       @default(0)

  // Performance flags
  meetsRequirements Boolean @default(true)
  warningCount    Int       @default(0)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  user            User      @relation(fields: [userId], references: [id])
  market          Market    @relation(fields: [marketId], references: [id])

  @@index([userId, periodStart])
  @@index([marketId])
  @@map("dmm_metrics")
}

// ============================================================================
// DMM REGISTRATION - Designated Market Maker Status
// ============================================================================

model DMMRegistration {
  id              String    @id @default(uuid())

  userId          String

  // DMM Status
  status          String    @default("pending") // pending, active, suspended, terminated
  tier            String    @default("standard") // standard, premium, institutional

  // Requirements
  minUptimePercent Float    @default(95) // Minimum required uptime
  maxSpreadCents  Int       @default(10) // Maximum allowed spread
  minLiquidityCents BigInt  @default(100000) // Minimum liquidity requirement

  // API Access
  apiRateLimit    Int       @default(0) // 0 = no rate limit (prioritized access)
  apiKeyHash      String?   // Hashed API key for DMM endpoints

  // Approval
  approvedAt      DateTime?
  approvedById    String?

  // Compliance
  lastComplianceCheck DateTime?
  complianceStatus String   @default("pending") // pending, compliant, warning, violation

